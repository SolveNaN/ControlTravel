@using ControlTravelApp.Components.Pages.Componentes
@using ControlTravelApp.Models
<ScriptEnlaces />
<!-- ***** Main Banner Area Start ***** -->
<section class="section main-banner" id="top" data-section="section1">
    <video autoplay muted loop id="bg-video">
        <source src="assets/images/bg.mp4" type="video/mp4" />
    </video>

    <div class="video-overlay header-text">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="caption">
                        <h6>Bienvenido Turista</h6>
                        <h2>Descubre Acacías, Meta</h2>
                        <p>Explora la belleza natural y la riqueza cultural de Acacías. Te ofrecemos los mejores <a rel="nofollow" href="https://templatemo.com/page/1" target="_blank">hoteles, restaurantes, y actividades</a>.</p>
                        <div class="main-button-red">
                            <div class="scroll-to-section"><a href="#contact">¡Únete a la aventura!</a></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- ***** Main Banner Area End ***** -->
<!-- ***** Services Area Start ***** -->
<section class="services">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="owl-service-item owl-carousel">
                    @foreach (var item in Tarjetas)                    {
                        
                        <Tarejeta Titulo="@item.Titulo" Descripcion="@item.Descripcion" Icono="@item.Icono" Link="@item.Link" />
                    }                 
                </div>
            </div>
        </div>
    </div>
</section>
<!-- ***** Services Area End ***** -->

<section class="upcoming-meetings" id="meetings">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-heading">
                    <h2>Restaurantes de Acacías</h2>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="categories">
                    <h4>Algunos restaurantes</h4>
                    <ul>
                        <li><a href="#">Mr Wu Express</a></li>
                        <br />
                        <li><a href="#">Frambuesa</a></li>
                        <li><a href="#">Restaurante Corral de Piedra</a></li>
                        <li><a href="#">Nuevo Oeste Gastrobar</a></li>
                    </ul>
                    <div class="main-button-red">
                        <a href="events.html">Ver más restaurantes...</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="row">
                    @foreach(var item in Unidades)
                    {
                        @if (item.Tipo == "Restaurante")
                        {
                            <Carta unidad="@item" />
                        }                        
                    }
                </div>
            </div>
        </div>
    </div>
</section>


<section class="apply-now" id="apply">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 align-self-center">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="item">
                            <h3>DESCUBRE ACACÍAS, META</h3>
                            <p>Explora las maravillas naturales, culturales y gastronómicas que Acacías, Meta tiene para ofrecer. Desde caminatas ecológicas hasta festivales folclóricos, hay algo para todos.</p>
                            <div class="main-button-red">
                                <div class="scroll-to-section"><a href="#contact">Únete a una experiencia ahora!</a></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="item">
                            <h3>EXPLORA AVENTURAS LOCALES</h3>
                            <p>Descubre las mejores actividades y eventos que te sumergen en la vida llanera. Vive la cultura y la naturaleza con guías locales expertos.</p>
                            <div class="main-button-yellow">
                                <div class="scroll-to-section"><a href="#contact">Reserva tu aventura!</a></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="accordions is-first-expanded">
                    <article class="accordion">
                        <div class="accordion-head">
                            <span>Acerca de Acacías</span>
                            <span class="icon">
                                <i class="icon fa fa-chevron-right"></i>
                            </span>
                        </div>
                        <div class="accordion-body">
                            <div class="content">
                                <p>Acacías es conocida por su hospitalidad y la belleza de su entorno natural. Situada en el corazón de los llanos orientales, es un destino ideal para quienes buscan una experiencia auténtica en Colombia. Desde actividades al aire libre hasta festivales culturales, Acacías lo tiene todo.</p>
                            </div>
                        </div>
                    </article>
                    <article class="accordion">
                        <div class="accordion-head">
                            <span>Actividades Recomendadas</span>
                            <span class="icon">
                                <i class="icon fa fa-chevron-right"></i>
                            </span>
                        </div>
                        <div class="accordion-body">
                            <div class="content">
                                <p>
                                    Disfruta de una amplia variedad de actividades, desde caminatas en la serranía hasta paseos a caballo por las haciendas llaneras. Las rutas turísticas incluyen recorridos por el río Guayuriba, donde podrás disfrutar de deportes acuáticos como rafting y canopy.<br><br>
                                    También podrás participar en talleres de gastronomía local, donde aprenderás a preparar los platos tradicionales de la región, como la mamona y el pan de arroz.
                                </p>
                            </div>
                        </div>
                    </article>
                    <article class="accordion">
                        <div class="accordion-head">
                            <span>Festivales y Eventos</span>
                            <span class="icon">
                                <i class="icon fa fa-chevron-right"></i>
                            </span>
                        </div>
                        <div class="accordion-body">
                            <div class="content">
                                <p>
                                    Acacías es famosa por sus festivales folclóricos que celebran la música y la danza llanera. El "Festival Folclórico y Reinado Nacional del Retorno" es uno de los eventos más importantes, donde se muestra el talento artístico de la región.<br><br>
                                    Además, durante todo el año, hay eventos como el "Día de la Llaneridad" y "Feria Artesanal", donde puedes conocer de cerca las tradiciones culturales.
                                </p>
                            </div>
                        </div>
                    </article>
                    <article class="accordion last-accordion">
                        <div class="accordion-head">
                            <span>Comparte con tus amigos</span>
                            <span class="icon">
                                <i class="icon fa fa-chevron-right"></i>
                            </span>
                        </div>
                        <div class="accordion-body">
                            <div class="content">
                                <p>
                                    Vive una experiencia inolvidable en Acacías y compártela con tus amigos. Invítalos a descubrir la belleza de los llanos orientales y a disfrutar de los paisajes, las tradiciones y la aventura.<br><br>
                                    No olvides traer tu cámara, porque los paisajes y las experiencias en Acacías son dignos de ser recordados y compartidos.
                                </p>
                            </div>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="our-courses" id="courses">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-heading">
                    <h2>
                        Turismo en Acacías y sus alrededores
                    </h2>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="owl-courses-item owl-carousel">
                    @foreach (var item in sitios)
                    {
                        <Postal Titulo="@item.Titulo" Calificacion="@item.Calificacion" UrlImg="@item.UrlImg" Valor="@item.Valor" />
                    }                  
                </div>
            </div>
        </div>
    </div>
</section>


<section class="our-facts">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="row">
                    <div class="col-lg-12">
                        <h2>Algunos Datos Sobre Acacías, Meta</h2>
                    </div>
                    <div class="col-lg-6">
                        <div class="row">
                            <MiniCarta Numero="20" Descripcion="Hoteles y Alojamientos" />
                            <MiniCarta Numero="25" Descripcion="Restaurantes" /> 
                            <MiniCarta Numero="12" Descripcion="Miradores" /> 
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="row">
                            <MiniCarta Numero="15" Descripcion="Sitios Turisticos" />
                            <MiniCarta Numero="6" Descripcion="Tipos de Transportes" />                            
                            <MiniCarta Numero="200" Descripcion="Locales adscritos" />                            
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 align-self-center">
                <div class="video">
                    <a href="https://www.youtube.com/watch?v=WyKQheMpwwc&ab_channel=ColombiaenDrone" target="_blank"><img src="assets/images/play-icon.png" alt=""></a>
                </div>
            </div>
        </div>
    </div>
</section>

  <section class="contact-us" id="contact">
    <div class="container">
      <div class="row">
        <div class="col-lg-9 align-self-center">
          <div class="row">
            <div class="col-lg-12">
              <form id="contact" action="" method="post">
                <div class="row">
                  <div class="col-lg-12">
                    <h2>Let's get in touch</h2>
                  </div>
                  <div class="col-lg-4">
                    <fieldset>
                      <input name="name" type="text" id="name" placeholder="YOURNAME...*" required="">
                    </fieldset>
                  </div>
                  <div class="col-lg-4">
                    <fieldset>
                    <input name="email" type="text" id="email" pattern="" placeholder="YOUR EMAIL..." required="">
                  </fieldset>
                  </div>
                  <div class="col-lg-4">
                    <fieldset>
                      <input name="subject" type="text" id="subject" placeholder="SUBJECT...*" required="">
                    </fieldset>
                  </div>
                  <div class="col-lg-12">
                    <fieldset>
                      <textarea name="message" type="text" class="form-control" id="message" placeholder="YOUR MESSAGE..." required=""></textarea>
                    </fieldset>
                  </div>
                  <div class="col-lg-12">
                    <fieldset>
                      <button type="submit" id="form-submit" class="button">SEND MESSAGE NOW</button>
                    </fieldset>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
        <div class="col-lg-3">
          <div class="right-info">
            <ul>
              <li>
                <h6>Phone Number</h6>
                <span>010-020-0340</span>
              </li>
              <li>
                <h6>Email Address</h6>
                <span>info@meeting.edu</span>
              </li>
              <li>
                <h6>Street Address</h6>
                <span>Rio de Janeiro - RJ, 22795-008, Brazil</span>
              </li>
              <li>
                <h6>Website URL</h6>
                <span>www.meeting.edu</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="footer">
      <p>Copyright © 2022 Edu Meeting Co., Ltd. All Rights Reserved. 
          <br>Design: <a href="https://templatemo.com" target="_parent" title="free css templates">TemplateMo</a></p>
    </div>
  </section>
